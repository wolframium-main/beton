#!/usr/bin/env bash
# mkinitcpio install 'beton': hosts.block + restore script + systemd unit.
# build() function for mkinitcpio. Installed by finalize.sh (VM only).
build() {
    add_file "/etc/beton/hosts.block" "/etc/beton/hosts.block"
    add_file "/usr/bin/beton-restore" "/usr/bin/beton-restore" 0755
    add_systemd_unit "beton-restore.service"
    # add_systemd_unit places the file, but the wants-symlink is explicit —
    # otherwise the unit never starts (caught in VM).
    add_symlink "/etc/systemd/system/initrd-switch-root.target.wants/beton-restore.service" \
        "/etc/systemd/system/beton-restore.service"
}

help() {
    cat <<'HELPEOF'
beton: restores DNS block into sysroot before switch_root (systemd unit)
HELPEOF
}
