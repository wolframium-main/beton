def do_apply(domains: list[str]) -> None:
    os.makedirs(STATE_DIR, exist_ok=True)
    # apply after an interrupted predecessor: drop stale immutable flags or EPERM
    # (caught in the VM matrix).
    try:
        unlock_files()
    except Exception:
        pass
    bdir = backup("pre-apply")
    print(f"Backup: {bdir}")
    kept = snapshot_allowlist()
    if kept:
        print(f"Tools that stay alive: {', '.join(kept)}")
    with open(DOMAINS_FILE, "w", encoding="utf-8") as f:
        f.write("\n".join(domains) + "\n")
    ips = resolve_ips(domains)
    apply_hosts(domains)
    apply_nft(domains, ips)
    apply_browser_policies(domains)
    install_self_and_watchdog()
    lock_files()
    log(f"apply: {','.join(domains)} backup={bdir}")
    # Check the guard actually holds
    fails = []
    try:
        for d in domains:
            if d.startswith("www."):
                continue
            try:
                if socket.gethostbyname(d) != "0.0.0.0":
                    fails.append(d)
            except OSError:
                pass
    except Exception:
        pass
    if fails:
        print(f"WARN: these names did not resolve to 0.0.0.0 via gethostbyname: {fails} (nft+policies still cut them, see status)")
    print("Done. Forget it. Live.")
    print("Removal: OS reinstall only (MVP has revert-for-testing for VM tests).")


def cmd_block(raw: list[str], assume_yes: bool, countdown: int = 10,
              breaks_half_internet: bool = False) -> int:
    if not is_root():
        print("sudo required: sudo ./beton block ...")
        return 2
    try:
        domains = expand_domains(raw)
    except ValueError as e:
        print(f"Error: {e}")
        return 2
    dang = find_dangerous(domains)
    if dang and not breaks_half_internet:
        print(f"STOP: {', '.join(dang)} — shared infra. This kills half the internet, not one site.")
        print("If you really mean it — add --i-know-this-breaks-half-internet.")
        print("I touched nothing.")
        return 3
    print(f"I will close forever: {', '.join(domains)}")
    print("The rest I won't touch: sudo, updates, files, other sites.")
    print("Bypass/removal attempts will be silently killed and rolled back. The site will look dead.")
    if not assume_yes:
        print(f"Type the phrase: {FOREVER_PHRASE}")
        ans = input("> ").strip()
        if ans != FOREVER_PHRASE:
            print("Cancelled. I touched nothing.")
            return 1
    print(f"Point of no return in {countdown}s. Ctrl+C is the last chance.")
    try:
        for i in range(countdown, 0, -1):
            print(f"  {i}...", flush=True)
            time.sleep(1)
    except KeyboardInterrupt:
        print("\nCancelled. Nothing touched.")
        return 1
    try:
        do_apply(domains)
    except Exception as e:
        print(f"APPLY ERROR: {e}")
        return 1
    return 0


EBPF_MAX_PATTERNS = 64
EBPF_MAX_PAT_LEN = 64


def render_ebpf_patterns(bases: list[str], port: int = 443) -> str:
    """Same format as l2/codegen.py. Parity covered by tests.
    Build and attach — VM only (see l2/)."""
    if len(bases) > EBPF_MAX_PATTERNS:
        raise ValueError(f"patterns {len(bases)} > {EBPF_MAX_PATTERNS}: cut the list")
    lines = [
        "/* AUTOGENERATED by beton gen-ebpf — do not edit. */",
        "#pragma once",
        "",
        f"#define BETON_NPATS {len(bases)}",
        f"#define BETON_MAX_PAT_LEN {EBPF_MAX_PAT_LEN}",
        f"#define BETON_PORT {port}",
        "",
        "struct beton_pat { __u8 len; __u8 data[BETON_MAX_PAT_LEN]; };",
        "",
        "__attribute__((unused)) static const struct beton_pat beton_pats[BETON_NPATS] = {",
    ]
    for p in bases:
        b = p.encode("ascii")
        if len(b) > EBPF_MAX_PAT_LEN:
            raise ValueError(f"pattern too long: {p}")
        lines.append(f"  {{ {len(b)}, {{{', '.join(str(x) for x in b)}}} }}, /* {p} */")
    lines += ["};", ""]
    return "\n".join(lines)


def cmd_gen_ebpf(raw: list[str], out: str, port: int = 443) -> int:
    try:
        domains = expand_domains(raw)
    except ValueError as e:
        print(f"Error: {e}")
        return 2
    bases = sorted({base_of(d) for d in domains})
    for p in bases:
        try:
            p.encode("ascii")
        except UnicodeEncodeError:
            print(f"non-ascii base after normalization: {p}")
            return 2
    try:
        text = render_ebpf_patterns(bases, port)
    except ValueError as e:
        print(f"Error: {e}")
        return 2
    with open(out, "w", encoding="utf-8") as f:
        f.write(text)
    print(f"{len(bases)} patterns port {port} -> {out} (build and attach — VM only, see l2/)")
    return 0


def cmd_interactive() -> int:
    if not is_root():
        print("Run with sudo, I do everything myself: sudo ./beton")
        print("To only preview the plan without changes: ./beton dry-run youtube.com")
        return 2
    print("== BETON: I do everything myself, no thinking needed ==")
    raw = input("Which sites to close forever? (space-separated, e.g.: youtube.com tiktok.com)\n> ").strip().split()
    if not raw:
        print("Empty — touched nothing.")
        return 1
    return cmd_block(raw, assume_yes=False)


def main() -> int:
    ap = argparse.ArgumentParser(prog="beton", description="invisible guard: closes sites forever")
    sub = ap.add_subparsers(dest="cmd")
    p = sub.add_parser("block", help="close forever")
    p.add_argument("domains", nargs="+")
    p.add_argument("--yes-i-understand-this-is-forever", action="store_true")
    p.add_argument("--i-know-this-breaks-half-internet", action="store_true")
    p.add_argument("--countdown", type=int, default=10)
    d = sub.add_parser("dry-run", help="show the plan without changes")
    d.add_argument("domains", nargs="+")
    sub.add_parser("status", help="check it holds")
    sub.add_parser("enforce", help="silently restore (internal)")
    sub.add_parser("revert-for-testing", help="ROLLBACK FOR VM TESTS ONLY")
    sub.add_parser("interactive", help="single-command mode")
    g = sub.add_parser("gen-ebpf", help="generate patterns.h for L2 (no root, no system changes)")
    g.add_argument("domains", nargs="+")
    g.add_argument("--out", default="patterns.h")
    g.add_argument("--port", type=int, default=443)
    ap.add_argument("--version", action="store_true", help="print version and exit")
    a = ap.parse_args()
    if a.version:
        print(f"{APP} {VERSION}")
        return 0
    if a.cmd == "block":
        if not a.yes_i_understand_this_is_forever:
            return cmd_block(a.domains, assume_yes=False, countdown=a.countdown,
                             breaks_half_internet=a.i_know_this_breaks_half_internet)
        return cmd_block(a.domains, assume_yes=True, countdown=a.countdown,
                         breaks_half_internet=a.i_know_this_breaks_half_internet)
    if a.cmd == "dry-run":
        return cmd_dry_run(a.domains)
    if a.cmd == "status":
        return cmd_status()
    if a.cmd == "enforce":
        if not is_root():
            print("sudo required.")
            return 2
        return cmd_enforce()
    if a.cmd == "revert-for-testing":
        return cmd_revert()
    if a.cmd == "gen-ebpf":
        return cmd_gen_ebpf(a.domains, a.out, a.port)
    return cmd_interactive()


if __name__ == "__main__":
    raise SystemExit(main())
