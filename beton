    for p in [HOSTS, NFT_RULES, PACMAN_HOOK,
              *[os.path.join(d, "90-beton.json") for d in CHROMIUM_POLICY_DIRS],
              *FIREFOX_POLICIES]:
        if os.path.isfile(p):
            run(["chattr", "-i", p])


def install_time() -> float:
    try:
        return os.stat(DOMAINS_FILE).st_mtime
    except OSError:
        return 0.0


def load_allowlist() -> tuple[set[str], dict[str, set[str]]]:
    """(bare names, pinned name->exe paths). Line format: `name` or `name:/path/to/exe`.
    Pinned entries survive package updates; bare names match any path (legacy)."""
    bare: set[str] = set()
    pinned: dict[str, set[str]] = {}
    try:
        with open(ALLOWLIST_PROCS_FILE, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                if ":" in line:
                    name, path = line.split(":", 1)
                    pinned.setdefault(name.strip(), set()).add(path.strip())
                else:
                    bare.add(line)
    except OSError:
        pass
    return bare, pinned


def exe_of(pid: str) -> str:
    try:
        return os.path.realpath(f"/proc/{pid}/exe")
    except OSError:
        return ""


def is_allowed(name: str, exe: str, bare: set[str], pinned: dict[str, set[str]]) -> bool:
    if name in bare:
        return True
    return bool(exe) and exe in pinned.get(name, set())


# System locations (pacman-managed, root-owned): never kill targets there.
# Rationale: routine package updates refresh mtimes, which would turn your own
# VPN helpers (e.g. Amnezia's bundled openvpn in /opt) into false kills.
# The killer hunts user-dropped bypass binaries (/tmp, /home, ...).
# A deliberate `sudo pacman -S tor` is beyond L1 scope (deliberate root wins L1).
SYSTEM_PREFIXES = ("/usr/", "/opt/")


def is_system_path(exe: str) -> bool:
    return bool(exe) and exe.startswith(SYSTEM_PREFIXES)


def iter_bypass_candidates() -> list[tuple[int, str]]:
    """Bypass processes installed AFTER setup. Pre-existing work tools untouched.
    Renaming a bypass binary to an allowlisted NAME does not help: the exe PATH
    must match the pinned path recorded at setup."""
    its = install_time()
    if not its:
        return []
    bare, pinned = load_allowlist()
    out: list[tuple[int, str]] = []
    try:
        pids = [p for p in os.listdir("/proc") if p.isdigit()]
    except OSError:
        return []
    for pid in pids:
        try:
            with open(f"/proc/{pid}/comm", encoding="utf-8") as f:
                name = f.read().strip()
        except OSError:
            continue
        if name not in BYPASS_PROC_NAMES:
            continue
        exe = exe_of(pid)
        if is_allowed(name, exe, bare, pinned):
            continue
        if is_system_path(exe):
            continue
        try:
            exe_mtime = os.stat(f"/proc/{pid}/exe").st_mtime
        except OSError:
            continue
        if exe_mtime > its:
            out.append((int(pid), name))
    return out


def snapshot_allowlist() -> list[str]:
    """Record currently running bypass-named tools (e.g. Amnezia's bundled
    openvpn) as pinned name:path entries, so later package updates that refresh
    exe mtimes do not turn your own VPN into a kill target."""
    found: dict[str, set[str]] = {}
    try:
        pids = [p for p in os.listdir("/proc") if p.isdigit()]
    except OSError:
        return []
    for pid in pids:
        try:
            with open(f"/proc/{pid}/comm", encoding="utf-8") as f:
                name = f.read().strip()
        except OSError:
            continue
        if name not in BYPASS_PROC_NAMES:
            continue
        exe = exe_of(pid)
        if exe:
            found.setdefault(name, set()).add(exe)
    lines = sorted(f"{n}:{p}" for n, paths in found.items() for p in sorted(paths))
    if lines:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(ALLOWLIST_PROCS_FILE, "w", encoding="utf-8") as f:
            f.write("# auto-snapshot at setup: your tools stay alive\n")
            f.write("\n".join(lines) + "\n")
    return lines


def kill_bypass_processes() -> list[tuple[int, str]]:
    killed = []
    for pid, name in iter_bypass_candidates():
        try:
            os.kill(pid, 9)
            killed.append((pid, name))
            log(f"kill: bypass process {name} pid={pid} killed")
        except OSError as e:
            log(f"kill FAILED {name} pid={pid}: {e}")
    return killed


def note_tamper(window_sec: int = 600, limit: int = 20) -> int:
    now = time.time()
    stamps: list[float] = []
    try:
        with open(TAMPER_COUNT_FILE, encoding="utf-8") as f:
            for line in f:
                try:
                    stamps.append(float(line.strip()))
                except ValueError:
                    continue
    except OSError:
        pass
    stamps = [t for t in stamps if now - t < window_sec] + [now]
    stamps = stamps[-limit:]
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(TAMPER_COUNT_FILE, "w", encoding="utf-8") as f:
            f.write("\n".join(str(t) for t in stamps) + "\n")
    except OSError:
        pass
    return len(stamps)


def tamper_count(window_sec: int = 600) -> int:
    now = time.time()
    try:
        with open(TAMPER_COUNT_FILE, encoding="utf-8") as f:
            return sum(1 for line in f
                       if line.strip() and now - float(line.strip()) < window_sec)
    except (OSError, ValueError):
        return 0


def punish_active() -> bool:
    try:
        with open(PUNISH_FLAG_FILE, encoding="utf-8") as f:
            return time.time() < float(f.read().strip())
    except (OSError, ValueError):
        return False


def engage_punish(minutes: int = 15) -> None:
    """Punishment for the attacking side only: cut QUIC/udp443 for a while.
    Normal sites fall back to TCP and work, bypasses get slower."""
    until = time.time() + minutes * 60
    try:
        os.makedirs(os.path.dirname(PUNISH_QUIC_NFT), exist_ok=True)
        with open(PUNISH_QUIC_NFT, "w", encoding="utf-8") as f:
            f.write("""# beton punish (temporary). Auto-lifted.
table inet beton_punish {
  chain out {
    type filter hook output priority 0; policy accept;
    udp dport 443 drop
  }
}
""")
        r = run(["nft", "-f", PUNISH_QUIC_NFT])
        if r.returncode != 0:
            log(f"punish nft FAILED: {r.stderr.strip()}")
            return
        with open(PUNISH_FLAG_FILE, "w", encoding="utf-8") as f:
            f.write(str(until))
        log(f"punish: QUIC-drop for {minutes} min after persistent attack")
    except OSError as e:
        log(f"punish FAILED: {e}")


def lift_punish_if_expired() -> None:
    if punish_active():
        return
    try:
        os.remove(PUNISH_FLAG_FILE)
    except OSError:
        pass
    r = run(["nft", "delete", "table", "inet", "beton_punish"])
    if r.returncode == 0:
        log("punish: expired, QUIC back")


def load_domains() -> list[str]:
    if not os.path.isfile(DOMAINS_FILE):
        return []
    return [l.strip() for l in open(DOMAINS_FILE, encoding="utf-8") if l.strip()]


