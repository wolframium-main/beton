def install_self_and_watchdog() -> None:
    src = os.path.abspath(sys.argv[0])
    if os.path.abspath(BIN_DST) != src:
        shutil.copy2(src, BIN_DST)
        os.chmod(BIN_DST, 0o755)
    with open(SERVICE, "w", encoding="utf-8") as f:
        f.write(SERVICE_TMPL)
    with open(TIMER, "w", encoding="utf-8") as f:
        f.write(TIMER_TMPL)
    os.makedirs(os.path.dirname(PACMAN_HOOK), exist_ok=True)
    with open(PACMAN_HOOK, "w", encoding="utf-8") as f:
        f.write(HOOK_TMPL)
    run(["systemctl", "daemon-reload"])
    # restart, а не start: после revert+reinstall enable --now оставляет таймер
    # в зависшем elapsed-состоянии без срабатываний (поймано в VM-матрице).
    run(["systemctl", "enable", "beton-enforce.timer"])
    r = run(["systemctl", "restart", "beton-enforce.timer"])
    if r.returncode != 0:
        raise RuntimeError(f"timer restart failed: {r.stderr.strip()}")


def lock_files() -> None:
    for p in [HOSTS, NFT_RULES, PACMAN_HOOK,
              *[os.path.join(d, "90-beton.json") for d in CHROMIUM_POLICY_DIRS],
              *FIREFOX_POLICIES]:
        if os.path.isfile(p):
            run(["chattr", "+i", p])


def unlock_files() -> None:
    for p in [HOSTS, NFT_RULES, PACMAN_HOOK,
              *[os.path.join(d, "90-beton.json") for d in CHROMIUM_POLICY_DIRS],
              *FIREFOX_POLICIES]:
        if os.path.isfile(p):
            run(["chattr", "-i", p])


def install_time() -> float:
    try:
        return os.stat(DOMAINS_FILE).st_mtime
    except OSError:
        return 0.0


def load_allowlist() -> set[str]:
    try:
        with open(ALLOWLIST_PROCS_FILE, encoding="utf-8") as f:
            return {l.strip() for l in f if l.strip() and not l.startswith("#")}
    except OSError:
        return set()


def iter_bypass_candidates() -> list[tuple[int, str]]:
    """Процессы-обходы, поставленные ПОСЛЕ установки. Рабочее до нас не трогаем."""
    its = install_time()
    if not its:
        return []
    allow = load_allowlist()
    out: list[tuple[int, str]] = []
    try:
        pids = [p for p in os.listdir("/proc") if p.isdigit()]
    except OSError:
        return []
    for pid in pids:
        try:
            with open(f"/proc/{pid}/comm", encoding="utf-8") as f:
                name = f.read().strip()
        except OSError:
            continue
        if name not in BYPASS_PROC_NAMES or name in allow:
            continue
        try:
            exe_mtime = os.stat(f"/proc/{pid}/exe").st_mtime
        except OSError:
            continue
        if exe_mtime > its:
            out.append((int(pid), name))
    return out


def kill_bypass_processes() -> list[tuple[int, str]]:
    killed = []
    for pid, name in iter_bypass_candidates():
        try:
            os.kill(pid, 9)
            killed.append((pid, name))
            log(f"kill: обходной процесс {name} pid={pid} убит")
        except OSError as e:
            log(f"kill FAILED {name} pid={pid}: {e}")
    return killed


def note_tamper(window_sec: int = 600, limit: int = 20) -> int:
    now = time.time()
    stamps: list[float] = []
    try:
        with open(TAMPER_COUNT_FILE, encoding="utf-8") as f:
            for line in f:
                try:
                    stamps.append(float(line.strip()))
                except ValueError:
                    continue
    except OSError:
        pass
    stamps = [t for t in stamps if now - t < window_sec] + [now]
    stamps = stamps[-limit:]
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(TAMPER_COUNT_FILE, "w", encoding="utf-8") as f:
            f.write("\n".join(str(t) for t in stamps) + "\n")
    except OSError:
        pass
    return len(stamps)


def tamper_count(window_sec: int = 600) -> int:
    now = time.time()
    try:
        with open(TAMPER_COUNT_FILE, encoding="utf-8") as f:
            return sum(1 for line in f
                       if line.strip() and now - float(line.strip()) < window_sec)
    except (OSError, ValueError):
        return 0


def punish_active() -> bool:
    try:
        with open(PUNISH_FLAG_FILE, encoding="utf-8") as f:
            return time.time() < float(f.read().strip())
    except (OSError, ValueError):
        return False


def engage_punish(minutes: int = 15) -> None:
    """Наказание только атакующего контура: режем QUIC/udp443 на время.
    Обычные сайты уходят в TCP-фолбэк и работают, обходы тормозятся."""
    until = time.time() + minutes * 60
    try:
        os.makedirs(os.path.dirname(PUNISH_QUIC_NFT), exist_ok=True)
        with open(PUNISH_QUIC_NFT, "w", encoding="utf-8") as f:
            f.write("""# beton punish (temporary). Auto-lifted.
table inet beton_punish {
  chain out {
    type filter hook output priority 0; policy accept;
    udp dport 443 drop
  }
}
""")
        r = run(["nft", "-f", PUNISH_QUIC_NFT])
        if r.returncode != 0:
            log(f"punish nft FAILED: {r.stderr.strip()}")
            return
        with open(PUNISH_FLAG_FILE, "w", encoding="utf-8") as f:
            f.write(str(until))
        log(f"punish: QUIC-drop на {minutes} мин за упорную атаку")
    except OSError as e:
        log(f"punish FAILED: {e}")


def lift_punish_if_expired() -> None:
    if punish_active():
        return
    try:
        os.remove(PUNISH_FLAG_FILE)
    except OSError:
        pass
    r = run(["nft", "delete", "table", "inet", "beton_punish"])
    if r.returncode == 0:
        log("punish: срок вышел, QUIC возвращен")


def load_domains() -> list[str]:
    if not os.path.isfile(DOMAINS_FILE):
        return []
    return [l.strip() for l in open(DOMAINS_FILE, encoding="utf-8") if l.strip()]


def cmd_dry_run(raw: list[str]) -> int:
    try:
        domains = expand_domains(raw)
    except ValueError as e:
        print(f"Ошибка: {e}")
        return 2
    ips = resolve_ips(domains)
    print("== BETON DRY-RUN (система НЕ меняется) ==")
    print(f"Домены ({len(domains)}): {', '.join(domains)}")
    dang = find_dangerous(domains)
    if dang:
        print(f"!!! СТОП: {', '.join(dang)} — общая инфра, ляжет пол-интернета.")
        print("!!! Нужен флаг --i-know-this-breaks-half-internet, иначе block откажет.")
    print(f"IP сейчас резолвятся ({len(ips)}): {', '.join(ips) if ips else '— (DNS не отдал, hosts+политики всё равно закроют имена)'}")
    print(f"DoH-блок: порты 853 + :443 к {', '.join(DOH_IPS)}")
    print("--- /etc/hosts добавит ---")
    print(build_hosts_block(domains), end="")
    print("--- nft rules ---")
    print(build_nft_rules(domains, ips), end="")
    print("--- chromium policy ---")
    print(build_chromium_policy(domains), end="")
    print("--- watchdog: beton-enforce.service + timer 30s + pacman hook ---")
    print(f"--- киллер обходов (только поставленные ПОСЛЕ установки, allowlist: {ALLOWLIST_PROCS_FILE}) ---")
    print(f"--- {', '.join(sorted(BYPASS_PROC_NAMES))} ---")
    print("--- лестница: restore молча -> 3 сноса за 10 мин = QUIC-drop на 15 мин (автоснятие) ---")
    print("OK: dry-run чистый. Для применения: sudo ./beton")
    return 0


def policies_ok(domains: list[str]) -> bool:
    """Политики на месте? Новый браузер после установки без них — тоже чинка."""
    try:
        want = set(json.loads(build_chromium_policy(domains))["URLBlocklist"])
    except ValueError:
        return False
    for d in CHROMIUM_POLICY_DIRS:
        # apply создаёт все эти пути — требовать все: снос любого чинится.
        p = os.path.join(d, "90-beton.json")
        try:
            have = set(json.loads(open(p, encoding="utf-8").read()).get("URLBlocklist", []))
        except (OSError, json.JSONDecodeError):
            return False
        if not want.issubset(have):
            return False
    for fp in FIREFOX_POLICIES:
        try:
            cur = json.loads(open(fp, encoding="utf-8").read() or "{}")
            have = set(cur.get("policies", {}).get("WebsiteFilter", {}).get("Block", []))
        except (OSError, json.JSONDecodeError):
            return False
        if not want.issubset(have):
            return False
    return True


def cmd_enforce() -> int:
    domains = load_domains()
    if not domains:
        return 0  # нечего сторожить — полная тишина (невидимость)
    lift_punish_if_expired()
    killed = kill_bypass_processes()
    try:
        with open(HOSTS, encoding="utf-8") as f:
            has = MARK_BEGIN in f.read()
    except OSError:
        has = False
    r = run(["nft", "list", "table", "inet", "beton"])
    nft_ok = r.returncode == 0
    pol_ok = policies_ok(domains)
    if has and nft_ok and pol_ok:
        return 0  # compliant — молчим, нас нет
    # Атака/снос замечен — молча восстанавливаем, без диалогов.
    try:
        unlock_files()
    except Exception:
        pass
    try:
        apply_hosts(domains)
        apply_nft(domains, resolve_ips(domains))
        apply_browser_policies(domains)
        lock_files()
        n = note_tamper()
        log(f"enforce: восстановлен блок {','.join(domains)} tamper10min={n} killed={killed}")
        if n >= 3 and not punish_active():
            engage_punish(15)
            time.sleep(3)  # измотать цикл «снести-за-1-сек», сторожу не вредит
    except Exception as e:
        log(f"enforce FAILED: {e}")
        return 1
    return 0


