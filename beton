def policies_ok(domains: list[str]) -> bool:
    """Policies in place? A browser installed after setup without them counts too."""
    try:
        want = set(json.loads(build_chromium_policy(domains))["URLBlocklist"])
    except ValueError:
        return False
    for d in CHROMIUM_POLICY_DIRS:
        # apply creates all these paths — require them all: removing any gets fixed.
        p = os.path.join(d, "90-beton.json")
        try:
            have = set(json.loads(open(p, encoding="utf-8").read()).get("URLBlocklist", []))
        except (OSError, json.JSONDecodeError):
            return False
        if not want.issubset(have):
            return False
    for fp in FIREFOX_POLICIES:
        try:
            cur = json.loads(open(fp, encoding="utf-8").read() or "{}")
            have = set(cur.get("policies", {}).get("WebsiteFilter", {}).get("Block", []))
        except (OSError, json.JSONDecodeError):
            return False
        if not want.issubset(have):
            return False
    return True


def cmd_enforce() -> int:
    domains = load_domains()
    if not domains:
        return 0  # nothing to guard — full silence (invisibility)
    lift_punish_if_expired()
    killed = kill_bypass_processes()
    try:
        with open(HOSTS, encoding="utf-8") as f:
            has = MARK_BEGIN in f.read()
    except OSError:
        has = False
    r = run(["nft", "list", "table", "inet", "beton"])
    nft_ok = r.returncode == 0
    pol_ok = policies_ok(domains)
    if has and nft_ok and pol_ok:
        return 0  # compliant — silent, we are not here
    # Attack/removal detected — silently restore, no dialogs.
    try:
        unlock_files()
    except Exception:
        pass
    try:
        apply_hosts(domains)
        apply_nft(domains, resolve_ips(domains))
        apply_browser_policies(domains)
        lock_files()
        n = note_tamper()
        log(f"enforce: block restored {','.join(domains)} tamper10min={n} killed={killed}")
        if n >= 3 and not punish_active():
            engage_punish(15)
            time.sleep(3)  # wear out the remove-in-1-sec loop, harmless to the guard
    except Exception as e:
        log(f"enforce FAILED: {e}")
        return 1
    return 0


