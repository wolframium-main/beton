def do_apply(domains: list[str]) -> None:
    os.makedirs(STATE_DIR, exist_ok=True)
    # apply после прерванного предшественника: снять старые immutable, иначе EPERM
    # (поймано в VM-матрице).
    try:
        unlock_files()
    except Exception:
        pass
    bdir = backup("pre-apply")
    print(f"Бэкап: {bdir}")
    with open(DOMAINS_FILE, "w", encoding="utf-8") as f:
        f.write("\n".join(domains) + "\n")
    ips = resolve_ips(domains)
    apply_hosts(domains)
    apply_nft(domains, ips)
    apply_browser_policies(domains)
    install_self_and_watchdog()
    lock_files()
    log(f"apply: {','.join(domains)} backup={bdir}")
    # Проверка что сторож реально держит
    fails = []
    try:
        for d in domains:
            if d.startswith("www."):
                continue
            try:
                if socket.gethostbyname(d) != "0.0.0.0":
                    fails.append(d)
            except OSError:
                pass
    except Exception:
        pass
    if fails:
        print(f"WARN: эти имена не ушли в 0.0.0.0 через gethostbyname: {fails} (nft+политики всё равно режут, см. status)")
    print("Готово. Забудь. Живи.")
    print("Снять: только переустановка ОС (в MVP для тестов в VM есть revert-for-testing).")


def cmd_block(raw: list[str], assume_yes: bool, countdown: int = 10,
              breaks_half_internet: bool = False) -> int:
    if not is_root():
        print("Нужно sudo: sudo ./beton block ...")
        return 2
    try:
        domains = expand_domains(raw)
    except ValueError as e:
        print(f"Ошибка: {e}")
        return 2
    dang = find_dangerous(domains)
    if dang and not breaks_half_internet:
        print(f"СТОП: {', '.join(dang)} — общая инфра. Это убьет пол-интернета, а не один сайт.")
        print("Если точно надо — добавь флаг --i-know-this-breaks-half-internet.")
        print("Я ничего не тронул.")
        return 3
    print(f"Я закрою навсегда: {', '.join(domains)}")
    print("Остальное не трону: sudo, обновления, файлы, другие сайты.")
    print("Обход/снос будет молча убит и откачен. Сайт будет выглядеть мертвым.")
    if not assume_yes:
        print(f"Введи фразу: {FOREVER_PHRASE}")
        ans = input("> ").strip()
        if ans != FOREVER_PHRASE:
            print("Отмена. Я ничего не тронул.")
            return 1
    print(f"Точка невозврата через {countdown}с. Ctrl+C — последний шанс.")
    try:
        for i in range(countdown, 0, -1):
            print(f"  {i}...", flush=True)
            time.sleep(1)
    except KeyboardInterrupt:
        print("\nОтмена. Ничего не тронуто.")
        return 1
    try:
        do_apply(domains)
    except Exception as e:
        print(f"ОШИБКА применения: {e}")
        return 1
    return 0


EBPF_MAX_PATTERNS = 64
EBPF_MAX_PAT_LEN = 64


def render_ebpf_patterns(bases: list[str], port: int = 443) -> str:
    """Тот же формат, что l2/codegen.py. Паритет проверяется тестами.
    Сборка и цепление — только в VM (см. l2/)."""
    if len(bases) > EBPF_MAX_PATTERNS:
        raise ValueError(f"паттернов {len(bases)} > {EBPF_MAX_PATTERNS}: режь список")
    lines = [
        "/* AUTOGENERATED by beton gen-ebpf — не править руками. */",
        "#pragma once",
        "",
        f"#define BETON_NPATS {len(bases)}",
        f"#define BETON_MAX_PAT_LEN {EBPF_MAX_PAT_LEN}",
        f"#define BETON_PORT {port}",
        "",
        "struct beton_pat { __u8 len; __u8 data[BETON_MAX_PAT_LEN]; };",
        "",
        "__attribute__((unused)) static const struct beton_pat beton_pats[BETON_NPATS] = {",
    ]
    for p in bases:
        b = p.encode("ascii")
        if len(b) > EBPF_MAX_PAT_LEN:
            raise ValueError(f"паттерн слишком длинный: {p}")
        lines.append(f"  {{ {len(b)}, {{{', '.join(str(x) for x in b)}}} }}, /* {p} */")
    lines += ["};", ""]
    return "\n".join(lines)


def cmd_gen_ebpf(raw: list[str], out: str, port: int = 443) -> int:
    try:
        domains = expand_domains(raw)
    except ValueError as e:
        print(f"Ошибка: {e}")
        return 2
    bases = sorted({base_of(d) for d in domains})
    for p in bases:
        try:
            p.encode("ascii")
        except UnicodeEncodeError:
            print(f"не-ascii база после нормализации: {p}")
            return 2
    try:
        text = render_ebpf_patterns(bases, port)
    except ValueError as e:
        print(f"Ошибка: {e}")
        return 2
    with open(out, "w", encoding="utf-8") as f:
        f.write(text)
    print(f"{len(bases)} паттернов порт {port} -> {out} (сборка и цепление — только в VM, см. l2/)")
    return 0


def cmd_interactive() -> int:
    if not is_root():
        print("Запусти с sudo, я сам всё сделаю: sudo ./beton")
        print("Хочешь только посмотреть план без изменений: ./beton dry-run youtube.com")
        return 2
    print("== BETON: я сам всё сделаю, думать не надо ==")
    raw = input("Какие сайты закрыть навсегда? (через пробел, например: youtube.com tiktok.com)\n> ").strip().split()
    if not raw:
        print("Пусто — ничего не тронул.")
        return 1
    return cmd_block(raw, assume_yes=False)


def main() -> int:
    ap = argparse.ArgumentParser(prog="beton", description="невидимый сторож: закрывает сайты навсегда")
    sub = ap.add_subparsers(dest="cmd")
    p = sub.add_parser("block", help="закрыть навсегда")
    p.add_argument("domains", nargs="+")
    p.add_argument("--yes-i-understand-this-is-forever", action="store_true")
    p.add_argument("--i-know-this-breaks-half-internet", action="store_true")
    p.add_argument("--countdown", type=int, default=10)
    d = sub.add_parser("dry-run", help="показать план без изменений")
    d.add_argument("domains", nargs="+")
    sub.add_parser("status", help="проверить держит ли")
    sub.add_parser("enforce", help="молча восстановить (внутреннее)")
    sub.add_parser("revert-for-testing", help="ОТКАТ ТОЛЬКО ДЛЯ VM-ТЕСТОВ")
    sub.add_parser("interactive", help="режим одной команды")
    g = sub.add_parser("gen-ebpf", help="сгенерировать patterns.h для L2 (без root, без изменений системы)")
    g.add_argument("domains", nargs="+")
    g.add_argument("--out", default="patterns.h")
    g.add_argument("--port", type=int, default=443)
    ap.add_argument("--version", action="store_true", help="версия и выход")
    a = ap.parse_args()
    if a.version:
        print(f"{APP} {VERSION}")
        return 0
    if a.cmd == "block":
        if not a.yes_i_understand_this_is_forever:
            return cmd_block(a.domains, assume_yes=False, countdown=a.countdown,
                             breaks_half_internet=a.i_know_this_breaks_half_internet)
        return cmd_block(a.domains, assume_yes=True, countdown=a.countdown,
                         breaks_half_internet=a.i_know_this_breaks_half_internet)
    if a.cmd == "dry-run":
        return cmd_dry_run(a.domains)
    if a.cmd == "status":
        return cmd_status()
    if a.cmd == "enforce":
        if not is_root():
            print("Нужно sudo.")
            return 2
        return cmd_enforce()
    if a.cmd == "revert-for-testing":
        return cmd_revert()
    if a.cmd == "gen-ebpf":
        return cmd_gen_ebpf(a.domains, a.out, a.port)
    return cmd_interactive()


if __name__ == "__main__":
    raise SystemExit(main())
