FINAL_FLAG = "/etc/beton/FINAL"


def is_final() -> bool:
    return os.path.exists(FINAL_FLAG)

MARK_BEGIN = "# >>> BETON >>>"
MARK_END = "# <<< BETON <<<"

# Известные DoH-терминалы, блокируем только их :443 + DoT 853.
# Обычный HTTPS не трогаем — сторож невидим для остального.
DOH_IPS = ["1.1.1.1", "1.0.0.1", "8.8.8.8", "8.8.4.4", "9.9.9.9", "149.112.112.112"]

# Стоп-лист: закрытие этих баз ломает пол-интернета (общий CDN/инфра).
# Требует отдельный флаг --i-know-this-breaks-half-internet.
DANGEROUS_BASES = {
    "google.com", "gstatic.com", "googleapis.com", "gvt1.com",
    "cloudflare.com", "cloudflare-dns.com", "amazonaws.com", "microsoft.com",
    "apple.com", "fbcdn.net",
}

# Процессы-обходы: убиваются только если бинарник появился ПОСЛЕ установки
# (т.е. поставлен ради обхода) и его нет в allowlist. Рабочее, стоявшее до нас, живет.
BYPASS_PROC_NAMES = {
    "tor", "torsocks", "openvpn",
    "wireguard", "wg-quick",
    "v2ray", "xray", "sing-box", "shadowsocks-rust", "sslh",
    "outline-client", "protonvpn", "mullvad-vpn",
}
ALLOWLIST_PROCS_FILE = os.path.join(STATE_DIR, "allowlist-procs.txt")
TAMPER_COUNT_FILE = os.path.join(STATE_DIR, "tamper.count")
PUNISH_FLAG_FILE = os.path.join(STATE_DIR, "punish-until")
PUNISH_QUIC_NFT = "/etc/beton/rules-punish.nft"

CHROMIUM_POLICY_DIRS = [
    "/etc/chromium/policies/managed",
    "/etc/opt/chrome/policies/managed",
    "/etc/brave/policies/managed",
    "/etc/vivaldi/policies/managed",
    "/etc/opera/policies/managed",
]
FIREFOX_POLICY = "/usr/lib/firefox/distribution/policies.json"
FIREFOX_POLICIES = [
    "/usr/lib/firefox/distribution/policies.json",
    "/usr/lib/firefox-esr/distribution/policies.json",
]

# Хардкод-DNS: убиваем обход через вшитый 8.8.8.8/1.1.1.1 в приложении.
# Системный резолвер по DHCP продолжает работать — остальное не трогаем.
PUBLIC_DNS_IPS = ["1.1.1.1", "1.0.0.1", "8.8.8.8", "8.8.4.4", "9.9.9.9", "149.112.112.112"]

FOREVER_PHRASE = "Я ПОНИМАЮ ЧТО ОБРАТНО ТОЛЬКО ЧЕРЕЗ ПЕРЕУСТАНОВКУ"


def log(msg: str) -> None:
    try:
        with open(LOG, "a", encoding="utf-8") as f:
            f.write(f"{datetime.datetime.now().isoformat(timespec='seconds')} {msg}\n")
    except OSError:
        pass


def is_root() -> bool:
    return os.geteuid() == 0


def run(cmd: list[str], check: bool = False) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, capture_output=True, text=True)


def normalize_domain(raw: str) -> str:
    d = raw.strip().lower()
    for p in ("https://", "http://"):
        if d.startswith(p):
            d = d[len(p):]
    d = d.split("/")[0].split(":")[0].strip().strip(".")
    if d.startswith("www."):
        d = d[4:]
    if not d or "." not in d or " " in d:
        raise ValueError(f"плохой домен: {raw!r}")
    try:
        d = d.encode("idna").decode("ascii")
    except Exception as e:
        raise ValueError(f"плохой домен {raw!r}: {e}")
    return d


def expand_domains(raw_list: list[str]) -> list[str]:
    seen: dict[str, None] = {}
    for r in raw_list:
        d = normalize_domain(r)
        seen[d] = None
        seen["www." + d] = None
    return sorted(seen)


def resolve_ips(domains: list[str]) -> list[str]:
    ips: dict[str, None] = {}
    for d in domains:
        for name in (d,):
            try:
                _, _, lst = socket.gethostbyname_ex(name)
                for ip in lst:
                    if "." in ip:
                        ips[ip] = None
            except OSError:
                continue
    return sorted(ips)


def base_of(d: str) -> str:
    b = d[4:] if d.startswith("www.") else d
    return b


def find_dangerous(domains: list[str]) -> list[str]:
    out = []
    for d in domains:
        if base_of(d) in DANGEROUS_BASES:
            out.append(d)
    return sorted(set(out))


def build_hosts_block(domains: list[str]) -> str:
    # hosts не понимает wildcard: пишем только точные имена.
    # Поддомены закрывают политики браузеров + DNS/IP + SNI (Stage 2).
    clean = [MARK_BEGIN]
    for d in domains:
        clean.append(f"0.0.0.0 {d}")
    clean.append(MARK_END)
    return "\n".join(clean) + "\n"


def merge_firefox_policies(existing: dict, want_block: list[str]) -> dict:
    pol = existing.setdefault("policies", {})
    have = pol.get("WebsiteFilter", {}).get("Block", [])
    pol["WebsiteFilter"] = {"Block": sorted(set(have) | set(want_block))}
    return existing


def build_nft_rules(domains: list[str], ips: list[str]) -> str:
    ip_set = ",\n    ".join(ips) if ips else "127.0.0.1"
    doh_set = ",\n    ".join(DOH_IPS)
    dns_set = ",\n    ".join(PUBLIC_DNS_IPS)
    return f"""# beton autogenerated. Do not edit: will be silently restored.
table inet beton {{
  set blocked_ipv4 {{
    type ipv4_addr
    flags interval
    elements = {{
      {ip_set}
    }}
  }}
  set doh_ipv4 {{
    type ipv4_addr
    flags interval
    elements = {{
      {doh_set}
    }}
  }}
  set pubdns_ipv4 {{
    type ipv4_addr
    flags interval
    elements = {{
      {dns_set}
    }}
  }}
  chain pre {{
    type filter hook prerouting priority -150; policy accept;
    ip daddr @blocked_ipv4 drop
    tcp dport 853 drop
    udp dport 853 drop
    ip daddr @doh_ipv4 tcp dport 443 drop
    ip daddr @pubdns_ipv4 udp dport 53 drop
    ip daddr @pubdns_ipv4 tcp dport 53 drop
  }}
  chain out {{
    type filter hook output priority 0; policy accept;
    ip daddr @blocked_ipv4 drop
    tcp dport 853 drop
    udp dport 853 drop
    ip daddr @doh_ipv4 tcp dport 443 drop
    ip daddr @pubdns_ipv4 udp dport 53 drop
    ip daddr @pubdns_ipv4 tcp dport 53 drop
  }}
}}
# NOTE (ascii only for nft parser): precise SNI filter + eBPF killer is Stage 2.
# MVP blocks via DNS + IP + browser policies.
# domains: {", ".join(domains)}
"""


def build_chromium_policy(domains: list[str]) -> str:
    # Два формата разом (проверено матрицей в VM на Chromium 153):
    # - bare hostname ("example.com"): единственный формат, который Chrome 153
    #   реально ест в URLBlocklist; покрывает и поддомены. Схемы "*://" он молча
    #   игнорирует — но они нужны Firefox WebsiteFilter, поэтому оставляем оба.
    patterns = []
    for d in domains:
        base = d[4:] if d.startswith("www.") else d
        patterns.append(base)
        patterns.append(f"*://{base}/*")
        patterns.append(f"*://*.{base}/*")
    return json.dumps({"URLBlocklist": sorted(set(patterns))}, ensure_ascii=False, indent=2) + "\n"


def read_hosts_without_beton() -> str:
    try:
        with open(HOSTS, encoding="utf-8") as f:
            text = f.read()
    except FileNotFoundError:
        return ""
    out = []
    skip = False
    for line in text.splitlines():
        if MARK_BEGIN in line:
            skip = True
            continue
        if MARK_END in line:
            skip = False
            continue
        if not skip:
            out.append(line)
    return "\n".join(out).rstrip("\n") + ("\n" if out else "")


def backup(tag: str) -> str:
    ts = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    dst = os.path.join(BACKUP_ROOT, f"backup-{ts}-{tag}")
    os.makedirs(dst, exist_ok=True)
    for src in (HOSTS, NFT_RULES, *FIREFOX_POLICIES):
        if os.path.isfile(src):
            shutil.copy2(src, os.path.join(dst, src.strip("/").replace("/", "_")))
    for src in CHROMIUM_POLICY_DIRS:
        p = os.path.join(src, "90-beton.json")
        if os.path.isfile(p):
            shutil.copy2(p, os.path.join(dst, "chromium_90-beton.json"))
    with open(os.path.join(dst, "domains.txt"), "w", encoding="utf-8") as f:
        if os.path.isfile(DOMAINS_FILE):
            f.write(open(DOMAINS_FILE, encoding="utf-8").read())
    return dst


def apply_hosts(domains: list[str]) -> None:
    base = read_hosts_without_beton()
    block = build_hosts_block(domains)
    with open(HOSTS, "w", encoding="utf-8") as f:
        f.write(base + block)


def apply_nft(domains: list[str], ips: list[str]) -> None:
    os.makedirs(os.path.dirname(NFT_RULES), exist_ok=True)
    with open(NFT_RULES, "w", encoding="utf-8") as f:
        f.write(build_nft_rules(domains, ips))
    r = run(["nft", "-c", "-f", NFT_RULES])
    if r.returncode != 0:
        raise RuntimeError(f"nft check failed: {r.stderr.strip()}")
    r = run(["nft", "-f", NFT_RULES])
    if r.returncode != 0:
        raise RuntimeError(f"nft apply failed: {r.stderr.strip()}")


def apply_browser_policies(domains: list[str]) -> None:
    payload = build_chromium_policy(domains)
    for d in CHROMIUM_POLICY_DIRS:
        os.makedirs(d, exist_ok=True)
        with open(os.path.join(d, "90-beton.json"), "w", encoding="utf-8") as f:
            f.write(payload)
    # Firefox (+ESR): мержим WebsiteFilter.Block в существующие policies.json,
    # остальные ключи не трогаем. Покрывает системные установки; portable/flatpak
    # с собственными путями закрываются сетевым слоем (hosts+nft), честное ограничение MVP.
    firefox_ok = 0
    for policy_path in FIREFOX_POLICIES:
        try:
            os.makedirs(os.path.dirname(policy_path), exist_ok=True)
            existing: dict = {}
            if os.path.isfile(policy_path):
                try:
                    existing = json.loads(open(policy_path, encoding="utf-8").read() or "{}")
                except json.JSONDecodeError:
                    existing = {}
            want = json.loads(payload)["URLBlocklist"]
            existing = merge_firefox_policies(existing, want)
            with open(policy_path, "w", encoding="utf-8") as f:
                json.dump(existing, f, ensure_ascii=False, indent=2)
                f.write("\n")
            firefox_ok += 1
        except OSError as e:
            print(f"WARN: firefox policy {policy_path} пропущен: {e}")
    if not firefox_ok:
        print("WARN: ни один firefox policy не записан")


